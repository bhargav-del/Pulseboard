{
  "name": "pulseboard",
  "version": "1.0.0",
  "description": "A calm command center for service health.",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dist": "electron-builder --win portable",
    "check": "node --check app.js"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "@capacitor/android": "^7.4.0",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/core": "^8.5.2"
  },
  "build": {
    "appId": "dev.yuin.pulseboard",
    "productName": "Pulseboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Pulseboard-Portable-${version}.exe"
    }
  }
}
